# FastAPI ML Service
# Copy this file to .env and fill in your values

# ─── Service ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ─── Models ────────────────────────────────────────────────────────────────────
# Directory where trained models are saved (relative to ml-service root)
MODEL_DIR=./models

# ─── Kaggle (optional — for Stack Overflow dataset download) ───────────────────
# Get credentials from: https://www.kaggle.com/settings → API
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key
